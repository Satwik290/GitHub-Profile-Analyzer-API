NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# TiDB Cloud connection. Replace <PASSWORD> with your TiDB Cloud password.
# Use an application database path, not /sys.
DATABASE_URL=mysql://root:<PASSWORD>@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/github_analyzer
MYSQL_SSL=true
MYSQL_CONNECTION_LIMIT=10
DB_AUTO_MIGRATE=true

# Optional but recommended to improve GitHub API rate limits.
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
