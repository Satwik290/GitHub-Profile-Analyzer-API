NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# TiDB Cloud / hosted MySQL option. When set, this takes precedence over MYSQL_HOST, MYSQL_PORT, MYSQL_USER, MYSQL_PASSWORD, and MYSQL_DATABASE.
# Replace <PASSWORD> with your TiDB Cloud password. Use an application database such as github_analyzer, not /sys.
DATABASE_URL=
MYSQL_CONNECTION_LIMIT=10
DB_AUTO_MIGRATE=true

# Local MySQL fallback. Used only when DATABASE_URL is empty/commented.
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=password
# MYSQL_DATABASE=github_analyzer
# MYSQL_SSL=false

# Optional but recommended to improve GitHub API rate limits.
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
